<?xml version="1.0" encoding="utf-8"?>
<!--
  Keeps learning progress and the unlock on this device only, as the in-app
  privacy policy states.

  On Android 12 and later, allowBackup="false" in the manifest stops cloud
  backup, but on some manufacturers' devices it does NOT stop device-to-device
  transfer when a user moves to a new phone. Only these rules govern that, so
  everything is excluded from both. Android 11 and earlier still use
  allowBackup / fullBackupContent in the manifest.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
